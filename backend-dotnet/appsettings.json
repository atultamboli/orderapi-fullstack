{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Cors": {
        "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4200" ]
    },
    "Ai": {
        "RequestsPerHour": 30
    },
    "OpenAI": {
        "ApiKey": ""
    },
    "Anthropic": {
        "ApiKey": ""
    },
    "Storage": {
        "UseMongoDb": true,
        "MongoDb": {
            "ConnectionString": "mongodb://localhost:27017",
            "DatabaseName": "OrderDb",
            "CollectionName": "orders"
        }
    }
}